{
  "name": "betterbuy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:icons": "pwa-assets-generator",
    "predev": "npm run generate:icons",
    "prebuild": "npm run generate:icons",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:storybook",
    "test:unit": "vitest run --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project=unit --coverage",
    "typecheck": "tsc --noEmit",
    "format:html": "prettier --write \"**/*.html\"",
    "format:html:check": "prettier --check \"**/*.html\"",
    "format:css": "prettier --write \"src/**/*.css\"",
    "format:css:check": "prettier --check \"src/**/*.css\"",
    "format:js": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,tsx}\"",
    "format:js:check": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,tsx}\"",
    "format": "prettier --write \"**/*.{html,css,js,mjs,cjs,jsx,ts,tsx,svg}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,cjs,jsx,ts,tsx,svg}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@redux-devtools/extension": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "storybook": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@vitest/browser": "3.2.7",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}

{
  "name": "betterbuy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:icons": "pwa-assets-generator",
    "predev": "npm run generate:icons",
    "prebuild": "npm run generate:icons",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format:html": "prettier --write \"**/*.html\"",
    "format:html:check": "prettier --check \"**/*.html\"",
    "format:css": "prettier --write \"src/**/*.css\"",
    "format:css:check": "prettier --check \"src/**/*.css\"",
    "format:js": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,tsx}\"",
    "format:js:check": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,tsx}\"",
    "format": "prettier --write \"**/*.{html,css,js,mjs,cjs,jsx,ts,tsx,svg}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,cjs,jsx,ts,tsx,svg}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@redux-devtools/extension": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "bootstrap": "^5.3.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
